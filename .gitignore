# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
*.env
.env
.env.*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# Datasets and local data mounts
/MMFi_DATA/
/data/
/datasets/
/Dataset/
/DATA/

